{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    // No default origins in the base config: each environment (dev, staging, prod)
    // must opt in explicitly via its own appsettings.{Environment}.json or env vars
    // (Cors__AllowedOrigins__0, Cors__AllowedOrigins__1, ...), instead of inheriting
    // a dev-only origin into environments where it would be wrong.
    "AllowedOrigins": []
  }
}
